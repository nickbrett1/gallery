# Environment variables for gallery (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.

LITELLM_BASE_URL=http://nas:4000
LITELLM_MASTER_KEY=
# The reader data dir mounted read-only: reader.db, images/, index/.
GALLERY_DATA=/data
# Local index backend (gallery opens the LanceDB directory directly).
INDEX_BACKEND=lancedb
