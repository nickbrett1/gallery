# Multi-stage image for gallery
# Generated by genproj (docker-container capability, language-aware); the
# runtime stage additionally copies the pruned dependency tree, because the
# native addons (@lancedb/lancedb, better-sqlite3) are externalised by Vite and
# cannot be bundled into build/. Adjust for your application.
#
# Stage 1 (build): copies the full source tree, installs dependencies, builds,
# then prunes dev dependencies. Stage 2 (runtime): copies the build output and
# the production node_modules.


FROM node:24-slim AS build
WORKDIR /app
COPY package.json package-lock.json* .npmrc* ./
RUN PINNED_NPM="$(node -p "try{require('./package.json').packageManager}catch(e){''}" 2>/dev/null || true)" \
    && if [ -n "$PINNED_NPM" ] && [ "$(npm --version)" != "${PINNED_NPM#npm@}" ]; then \
         echo "Activating pinned ${PINNED_NPM}..."; \
         npm install -g "${PINNED_NPM}" >/dev/null || true; \
       fi \
    && if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:24-slim
WORKDIR /app
# Link the GHCR container package to its GitHub repo on push. GHCR auto-links
# the package to nickbrett1/gallery so it inherits the
# repo's access (public repo -> public package; no manual visibility step).
LABEL org.opencontainers.image.source=https://github.com/nickbrett1/gallery

ENV NODE_ENV=production
# Native addons are externalised by Vite (see vite.config.js `ssr.external`), so
# the runtime image needs the production dependency tree next to build/.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/build ./build
COPY --from=build /app/package.json ./package.json
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node","build"]
